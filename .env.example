# Copy to .env (git-ignored) and adjust. Read by docker compose and by the 'dev' profile.
POSTGRES_DB=epos
POSTGRES_USER=epos
POSTGRES_PASSWORD=change-me

DB_URL=jdbc:postgresql://localhost:5432/epos
DB_USERNAME=epos
DB_PASSWORD=change-me

# prod only: comma-separated allowed frontend origins
EPOS_CORS_ALLOWED_ORIGINS=http://localhost:4200
